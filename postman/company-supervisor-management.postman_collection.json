  "item": [
    {
      "name": "01 管理員登入",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now().toString();",
              "pm.collectionVariables.set('suffix', suffix);",
              "pm.collectionVariables.set('companyAName', `Postman甲公司-${suffix}`);",
              "pm.collectionVariables.set('companyBName', `Postman乙公司-${suffix}`);",
              "pm.collectionVariables.set('user1Name', `Postman主管甲-${suffix}`);",
              "pm.collectionVariables.set('employeeName', `Postman員工-${suffix}`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('管理員登入 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('管理員角色正確', () => pm.expect(body.data.roles).to.include('SYSTEM_ADMIN'));",
              "pm.collectionVariables.set('adminToken', body.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "02 一般使用者登入",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('一般使用者登入 200', () => pm.response.to.have.status(200));",
        "pm.collectionVariables.set('userToken', pm.response.json().data.token);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"user\",\"password\":\"admin123\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "03 一般使用者禁止查詢公司",
      "event": [{ "listen": "test", "script": { "exec": [
        "pm.test('權限不足 403', () => pm.response.to.have.status(403));",
        "pm.test('模組訊息正確', () => pm.expect(pm.response.json().message).to.eql('[公司主管管理] [api] 無系統管理員權限。'));"
      ] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/admin/company-supervisor-management/companies", "host": ["{{baseUrl}}"], "path": ["api", "admin", "company-supervisor-management", "companies"] }
      }
    },
    {
      "name": "04 建立甲公司",
      "event": [{ "listen": "test", "script": { "exec": [
