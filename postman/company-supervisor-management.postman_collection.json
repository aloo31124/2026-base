        "pm.test('甲公司 response 正確', () => { pm.expect(companyAResponse.name).to.eql(pm.collectionVariables.get('companyAName')); pm.expect(companyAResponse.description).to.eql('Postman 公司 A'); });",
        "pm.collectionVariables.set('companyAId', companyAResponse.id);"
      ] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }, { "key": "Content-Type", "value": "application/json" }],
