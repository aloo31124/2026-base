    {
      "name": "01 管理員登入",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const suffix = Date.now().toString();",
              "const today = new Date(); const yesterday = new Date(today); const tomorrow = new Date(today);",
              "yesterday.setUTCDate(yesterday.getUTCDate() - 1); tomorrow.setUTCDate(tomorrow.getUTCDate() + 1);",
              "pm.collectionVariables.set('suffix', suffix);",
              "pm.collectionVariables.set('companyName', `Postman報表公司-${suffix}`);",
              "pm.collectionVariables.set('managerUsername', `postman.report.manager.${suffix}`);",
              "pm.collectionVariables.set('employeeUsername', `postman.report.employee.${suffix}`);",
              "pm.collectionVariables.set('today', today.toISOString().slice(0, 10));",
              "pm.collectionVariables.set('yesterday', yesterday.toISOString().slice(0, 10));",
              "pm.collectionVariables.set('tomorrow', tomorrow.toISOString().slice(0, 10));",
              "pm.collectionVariables.set('deadline', new Date(Date.now() + 172800000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('管理員登入 200', () => pm.response.to.have.status(200));",
              "var responseData = pm.response.json().data;",
              "pm.test('管理員角色正確', () => pm.expect(responseData.roles).to.include('SYSTEM_ADMIN'));",
              "pm.collectionVariables.set('adminToken', responseData.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}"
        }
      }
    },
