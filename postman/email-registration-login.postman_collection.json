{
  "info": {"name": "AgentFlow 信箱註冊登入", "_postman_id": "6d40c9ac-28f0-4a35-b584-13cd4c304007", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key":"baseUrl","value":"http://localhost:8080/api"},{"key":"email","value":""},{"key":"code","value":""},{"key":"resetCode","value":""}],
  "item": [
    {"name":"寄送註冊驗證碼","event":[{"listen":"prerequest","script":{"exec":["pm.collectionVariables.set('email', 'newman.' + Date.now() + '@agentflow.local');"]}},{"listen":"test","script":{"exec":["pm.test('200 success',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().success).to.eql(true);});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\"}"},"url":"{{baseUrl}}/auth/email/registrations/code"}},
    {"name":"取得測試註冊碼","event":[{"listen":"test","script":{"exec":["pm.test('capture code',()=>{pm.response.to.have.status(200);pm.collectionVariables.set('code',pm.response.json().data);pm.expect(pm.response.json().data).to.match(/^\\d{6}$/);});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/auth/email/test-code?email={{email}}&purpose=REGISTER"}},
    {"name":"完成註冊","event":[{"listen":"test","script":{"exec":["pm.test('registered with employee role',()=>{let j=pm.response.json();pm.response.to.have.status(200);pm.expect(j.data.username).to.eql(pm.collectionVariables.get('email'));pm.expect(j.data.roles).to.include('EMPLOYEE');});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"fullName\":\"Newman 信箱會員\",\"email\":\"{{email}}\",\"password\":\"Member123\",\"code\":\"{{code}}\"}"},"url":"{{baseUrl}}/auth/email/registrations"}},
    {"name":"信箱帳密登入","event":[{"listen":"test","script":{"exec":["pm.test('email login',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().data.token).to.be.a('string');});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"{{email}}\",\"password\":\"Member123\"}"},"url":"{{baseUrl}}/auth/login"}},
    {"name":"寄送重設碼","event":[{"listen":"test","script":{"exec":["pm.test('generic reset response',()=>pm.response.to.have.status(200));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\"}"},"url":"{{baseUrl}}/auth/email/password-resets/code"}},
    {"name":"取得測試重設碼","event":[{"listen":"test","script":{"exec":["pm.test('capture reset code',()=>{pm.response.to.have.status(200);pm.collectionVariables.set('resetCode',pm.response.json().data);});"]}}],"request":{"method":"GET","url":"{{baseUrl}}/auth/email/test-code?email={{email}}&purpose=RESET_PASSWORD"}},
    {"name":"更新密碼","event":[{"listen":"test","script":{"exec":["pm.test('password reset',()=>pm.response.to.have.status(200));"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"{{email}}\",\"newPassword\":\"Changed456\",\"code\":\"{{resetCode}}\"}"},"url":"{{baseUrl}}/auth/email/password-resets"}},
    {"name":"新密碼登入","event":[{"listen":"test","script":{"exec":["pm.test('new password login',()=>{pm.response.to.have.status(200);pm.expect(pm.response.json().success).to.eql(true);});"]}}],"request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"username\":\"{{email}}\",\"password\":\"Changed456\"}"},"url":"{{baseUrl}}/auth/login"}}
  ]
}
