{
  "info": {
    "_postman_id": "e73bb2f5-1adf-4d4f-9677-9df3e92424f5",
    "name": "AgentFlow 信箱註冊登入",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "email", "value": "" },
    { "key": "verificationCode", "value": "123456" },
    { "key": "registrationTicket", "value": "" },
    { "key": "resetTicket", "value": "" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "01 首次信箱寄送註冊碼",
      "event": [
        {
          "listen": "prerequest",
          "script": { "exec": ["pm.collectionVariables.set('email', `postman.${Date.now()}@example.com`);"] }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('註冊碼寄送成功', () => pm.response.to.have.status(200));",
              "pm.test('回應不含驗證碼', () => pm.expect(pm.response.text()).not.to.include(pm.collectionVariables.get('verificationCode')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/registration-code", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "registration-code"] }
      }
    },
    {
      "name": "02 核銷註冊驗證碼",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('驗證碼核銷成功', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.collectionVariables.set('registrationTicket', json.data.ticketId);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"code\":\"{{verificationCode}}\",\"purpose\":\"REGISTRATION\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/verify", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "verify"] }
      }
    },
    {
      "name": "03 設定密碼完成註冊",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('註冊並自動登入成功', () => pm.response.to.have.status(200));",
            "const json = pm.response.json();",
            "pm.test('帳號即信箱', () => pm.expect(json.data.username).to.eql(pm.collectionVariables.get('email')));",
            "pm.test('最小權限為 EMPLOYEE', () => pm.expect(json.data.roles).to.include('EMPLOYEE'));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"ticketId\":\"{{registrationTicket}}\",\"password\":\"password123\",\"confirmPassword\":\"password123\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "register"] }
      }
    },
    {
      "name": "04 信箱帳密登入",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('信箱密碼登入成功', () => pm.response.to.have.status(200));"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"{{email}}\",\"password\":\"password123\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "05 重複信箱提醒",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('重複信箱回覆 409', () => pm.response.to.have.status(409));",
            "pm.test('回覆明確提醒', () => pm.expect(pm.response.json().message).to.eql('此信箱已註冊。'));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/registration-code", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "registration-code"] }
      }
    },
    {
      "name": "06 寄送忘記密碼驗證碼",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('重設碼寄送成功', () => pm.response.to.have.status(200));"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/password-reset-code", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "password-reset-code"] }
      }
    },
    {
      "name": "07 核銷忘記密碼驗證碼",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('重設驗證碼核銷成功', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('resetTicket', pm.response.json().data.ticketId);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"code\":\"{{verificationCode}}\",\"purpose\":\"PASSWORD_RESET\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/verify", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "verify"] }
      }
    },
    {
      "name": "08 更新密碼",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('密碼更新成功', () => pm.response.to.have.status(200));"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"email\":\"{{email}}\",\"ticketId\":\"{{resetTicket}}\",\"password\":\"newPassword456\",\"confirmPassword\":\"newPassword456\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/email/password-reset", "host": ["{{baseUrl}}"], "path": ["api", "auth", "email", "password-reset"] }
      }
    },
    {
      "name": "09 新密碼登入",
      "event": [{
        "listen": "test",
        "script": { "exec": ["pm.test('新密碼登入成功', () => pm.response.to.have.status(200));"] }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"{{email}}\",\"password\":\"newPassword456\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "10 管理員登入",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('管理員登入成功', () => pm.response.to.have.status(200));",
            "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"username\":\"admin\",\"password\":\"admin123\"}" },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },
    {
      "name": "11 管理員測試寄信",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('管理員測試寄信成功', () => pm.response.to.have.status(200));",
            "pm.test('response 不含驗證碼', () => pm.expect(pm.response.text()).not.to.include(pm.collectionVariables.get('verificationCode')));"
          ]
        }
      }],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\"email\":\"audit@example.com\"}" },
        "url": { "raw": "{{baseUrl}}/api/admin/email-verification/send", "host": ["{{baseUrl}}"], "path": ["api", "admin", "email-verification", "send"] }
      }
    },
    {
      "name": "12 查詢資料庫寄送紀錄",
      "event": [{
        "listen": "test",
        "script": {
          "exec": [
            "pm.test('寄送紀錄查詢成功', () => pm.response.to.have.status(200));",
            "const first = pm.response.json().data[0];",
            "pm.test('最新紀錄為管理員測試成功', () => { pm.expect(first.purpose).to.eql('ADMIN_TEST'); pm.expect(first.status).to.eql('SUCCESS'); });"
          ]
        }
      }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
        "url": { "raw": "{{baseUrl}}/api/admin/email-verification/logs", "host": ["{{baseUrl}}"], "path": ["api", "admin", "email-verification", "logs"] }
      }
    }
  ]
}
