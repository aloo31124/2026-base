# 複製為 .env 後依需要調整（.env 已被 .gitignore 忽略，勿提交）。
#
# 用途區分：
#   - docker compose 會自動讀取同目錄的 .env 做變數替換 → MSSQL_SA_PASSWORD 走這條
#   - Spring Boot 讀的是「作業系統環境變數」，不會自動讀 .env
#     → DB_* / JWT_* / CORS_* 需自行 export，或直接沿用 application.yml 的預設值

# --- docker compose 用 ---
# 本機 MSSQL 容器的 sa 密碼，須符合 SQL Server 複雜度原則（大小寫＋數字＋符號、8 碼以上）
MSSQL_SA_PASSWORD=Base20260716#01!

# --- Spring Boot 用（未設定時採用 application.yml 的預設值） ---
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=base_20260716_01;encrypt=true;trustServerCertificate=true
DB_USERNAME=base_20260716_01
DB_PASSWORD=base_20260716_01

JWT_SECRET=agentflow-base-2026-jwt-secret-must-have-at-least-32-bytes
JWT_EXPIRATION_MINUTES=120

CORS_ALLOWED_ORIGIN=http://localhost:5173
